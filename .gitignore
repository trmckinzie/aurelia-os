# --- IGNORE OBSIDIAN CONFIGS (Crucial for Sync) ---
# We ignore the workspace (scroll position) but KEEP plugins/settings
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json

# --- IGNORE SYSTEM FILES ---
.DS_Store
Thumbs.db

# --- IGNORE PYTHON/DEV FILES ---
.venv/
__pycache__/
*.pyc
.env
.pytest_cache/

# --- IGNORE NODE/TAILWIND BUILD FILES ---
node_modules/
# Regenerated from engine/config.py THEME_CONFIG on every build; not source.
tailwind.config.js

# --- IGNORE SMART CONNECTIONS PLUGIN DATA ---
**/.smart-env/

# --- IGNORE GIT CREDENTIAL SCRATCH FILES (obsidian-git plugin askpass IPC) ---
# The plugin writes here when it needs credentials interactively for a git
# operation -- currently just the empty prompt template, but this is exactly
# the kind of path that could carry a real token in a future session, so it
# should never be tracked.
**/obsidian-git/git_credentials_input
**/obsidian-git/git_credentials_input.response

# --- IGNORE BUILD ARTIFACTS (CRITICAL) ---
dist/