# Normalize line endings to LF in the repo; Git still checks out text files
# using the platform's native line ending unless overridden below.
* text=auto eol=lf

*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary vault/site assets: never diff or line-ending-normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.m4a binary
*.wav binary
*.mov binary
*.webm binary
